# ── MinIO ─────────────────────────────────────────────────────────────────────
# Alamat MinIO server (tanpa http://)
MINIO_ENDPOINT=192.168.100.23:9000

# Kredensial MinIO (ganti setelah install)
MINIO_ACCESS_KEY=archiva
MINIO_SECRET_KEY=futureWithBinawan!

# Nama bucket untuk menyimpan banner
MINIO_BUCKET=banners

# URL publik yang bisa diakses oleh halaman hotspot
# Jika MinIO di server yang sama dengan Go API, isi IP server Anda
# Contoh: http://192.168.1.10:9000/banners
MINIO_PUBLIC_BASE=http://192.168.100.23:9000/banners

# Gunakan HTTPS ke MinIO? (true/false)
MINIO_USE_SSL=false

# ── API Server ────────────────────────────────────────────────────────────────
# Port Go API
LISTEN_ADDR=:8098

# Token rahasia untuk proteksi endpoint upload/delete
# Ganti dengan string acak yang panjang!
ADMIN_SECRET=binawanfuture2030